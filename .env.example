# ==============================================================================
# Pipeline Configuration Environment Variables Template (.env.example)
# ==============================================================================
# Rename this file to '.env' and modify values to customize the local deployment.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=mash
POSTGRES_PASSWORD=mash123
POSTGRES_DB=finance_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432       # Port exposed on the host machine

# Cache Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_HOST=6379         # Port exposed on the host machine
REDIS_PASSWORD=""

# Ingestion configurations
EXCHANGE=Nairobi Securities Exchange (NSE)
STREAM_INTERVAL_SECONDS=5
SIMULATION_MODE=true         # Set to 'false' to pull live data from Yahoo Finance

# Serving Ports Configuration
API_PORT_HOST=8000           # Port exposed on host for Uvicorn
DASHBOARD_PORT_HOST=8501     # Port exposed on host for Streamlit

# API connection URL for Streamlit
API_URL=http://api:8000
